# Server
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# Auth
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Code execution (self-hosted Piston — see D:\piston)
PISTON_URL=http://localhost:2000/api/v2/execute

# LiveKit
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# WebRTC (STUN/TURN) — unused while on LiveKit, kept for config completeness
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# AI report generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email (leave blank = mock/console-log mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@meetspace.com